# Copy this file to ".env" (same folder) and paste your key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Optional
GEMINI_MODEL=gemini-3.8-flash
# Optional backup model used if the main one is overloaded (leave blank to skip)
GEMINI_FALLBACK_MODEL=
PORT=3000
# Comma-separated list of sites allowed to call the API. "*" = anyone (fine for local testing).
# In production use your real site, e.g. https://government-helpline-8obu.bolt.host
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MIN=15
